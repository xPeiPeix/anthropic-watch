# Anthropic Watch quota monitor - configuration template.
#
# Copy this file to "aw_config.local.env" (same directory) and fill in the
# values for your machine. aw_config.local.env is git-ignored and never
# committed. Every key can also be supplied as an OS environment variable,
# which takes precedence over this file.
#
# Precedence: OS environment variable > aw_config.local.env > built-in default.

# --- Required: deployment-specific paths / endpoints -------------------------

# YAML file holding the AI gateway key. The watcher reads the key whose
# entry name is "default-consumer" under providers.gateway_newapi.keys.
AW_TOKENS_SECRET=

# A .env-style file that provides EMAIL_SENDER, EMAIL_PASSWORD and
# (optionally) TAVILY_API_KEYS. Reused as-is; nothing is written back.
AW_EMAIL_ENV=

# OpenAI-compatible chat-completions endpoint of your AI gateway, e.g.
# https://your-gateway.example.com/v1/chat/completions
AW_GATEWAY_URL=

# --- Optional: override only if the defaults do not fit ----------------------

# Claude Code OAuth credentials (defaults to ~/.claude/.credentials.json).
# AW_CLAUDE_CREDENTIALS=

# Model used for announcement classification (cheap is fine).
# AW_GATEWAY_MODEL=gemini-2.5-flash

# Snapshot + dedup-state file locations (default: ./assets and ./data).
# AW_OUTPUT=
# AW_STATE=

# Lookback window in days and max Tavily web results per run.
# AW_DAYS=14
# AW_TAVILY_MAX=10

# Python launcher for the scheduled task (used by run_quota_watch.cmd /
# register_task.ps1). Leave unset to auto-detect pythonw/python on PATH.
# AW_PYTHON=
